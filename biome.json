{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/cjs",
      "!**/esm",
      "!**/dist",
      "!**/coverage",
      "!**/package-lock.json",
      "!**/*.d.ts",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noInvalidUseBeforeDeclaration": "error"
      },
      "complexity": {
        "noForEach": "off"
      },
      "style": {
        "useConst": "warn",
        "useTemplate": "warn",
        "noNonNullAssertion": "off",
        "noParameterAssign": "off"
      },
      "suspicious": {
        "noDebugger": "warn",
        "noDoubleEquals": "error",
        "noExplicitAny": "off",
        "noVar": "error",
        "noConsole": {
          "level": "off",
          "options": {
            "allow": ["log"]
          }
        }
      }
    }
  }
}
