{
  "name": "corriere",
  "version": "1.1.0",
  "description": "Fast, flexible, zero-dependency modern HTTP client for JS/TS",
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "author": "salvatorecorvaglia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salvatorecorvaglia/corriere.git"
  },
  "bugs": {
    "url": "https://github.com/salvatorecorvaglia/corriere/issues"
  },
  "homepage": "https://github.com/salvatorecorvaglia/corriere",
  "sideEffects": false,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./cjs/index.d.cts",
        "default": "./cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "cjs/",
    "esm/"
  ],
  "scripts": {
    "build:cjs": "tsup",
    "build": "pnpm run build:cjs",
    "prepublishOnly": "pnpm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "release:npm": "gh workflow run publish-npm.yml -f publish_tag=$(git describe --tags --abbrev=0)",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
